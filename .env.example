# ============================================================================
# APPLICATION CONFIGURATION - ENVIRONMENT VARIABLES
# ============================================================================
# This is an example .env file. To use it:
# 1. Copy this file to .env
# 2. Fill in your actual credentials and settings
# 3. Never commit .env to version control!
#
# This is an alternative to config.php for those who prefer environment variables
# You can use a library like vlucas/phpdotenv to load these variables in PHP
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_CHARSET=utf8mb4

# ============================================================================
# SMTP/EMAIL CONFIGURATION
# ============================================================================
SMTP_USERNAME=your_email@example.com
SMTP_PORT=465
SMTP_HOST=ssl://smtp.example.com
SMTP_PASSWORD=your_smtp_password
SMTP_DEBUG=false
SMTP_CHARSET=utf-8
SMTP_FROM=Your App Name

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================
ADMIN_EMAIL=admin@example.com

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
TEMPLATES=:en:ru:fu:

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Security salt - used for password hashing and other cryptographic operations
# IMPORTANT: Change this to a unique random string!
# You can generate a random salt using: openssl rand -base64 32
SALT=your_unique_salt_here_change_this

# Secret key for admin hash generation
ADMIN_SECRET_KEY=your_secret_key_here

# ============================================================================
# SMS SERVICE CONFIGURATION
# ============================================================================
SMS_SADR=pwd
SMS_OP=http://gateway.api.sc/get/?user=your_username&pwd=your_password

# Alternative SMS endpoint (uncomment if needed):
# SMS_OP=http://95.213.129.83/sendsms.php?user=your_username&pwd=your_password

# ============================================================================
# GOOGLE OAUTH CONFIGURATION
# ============================================================================
# Get these credentials from: https://console.developers.google.com/
G_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
G_CLIENT_PK=your_google_client_secret

# ============================================================================
# YANDEX OAUTH CONFIGURATION
# ============================================================================
# Get these credentials from: https://oauth.yandex.com/
Y_CLIENT_ID=your_yandex_client_id
Y_CLIENT_PK=your_yandex_client_secret
